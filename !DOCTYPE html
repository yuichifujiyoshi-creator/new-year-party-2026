<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2026年 新年会のお知らせ</title>
    <!-- OGP Settings: SNSでシェアした時の見栄えを良くします -->
    <meta property="og:title" content="2026年 新年会のお知らせ">
    <meta property="og:description" content="1/8(木) 19:30より、シュマッツ 日本橋髙島屋 S.C.にて開催！">
    <meta property="og:type" content="website">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
            background-color: #FFFBEB;
            color: #1F2937;
        }
        .card-shadow {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 500px;
            height: 300px;
            margin: auto;
        }
        #bubbleCanvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            pointer-events: none;
        }
        .animate-fade-in { animation: fadeIn 0.5s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <header class="relative bg-amber-600 overflow-hidden text-white shadow-lg">
        <canvas id="bubbleCanvas"></canvas>
        <div class="relative z-10 max-w-4xl mx-auto px-4 py-12 text-center">
            <span class="inline-block px-3 py-1 bg-amber-800 text-amber-100 rounded-full text-xs font-bold mb-4">Official Invitation</span>
            <h1 class="text-4xl md:text-6xl font-bold mb-2">2026年 新年会</h1>
            <p class="text-lg md:text-xl font-light opacity-90">Schmatz Nihombashi Takashimaya S.C.</p>
            
            <div id="countdown-container" class="mt-8 grid grid-cols-4 gap-2 max-w-lg mx-auto text-amber-900">
                <div class="bg-white/95 rounded-lg p-2 text-center shadow-inner">
                    <div id="days" class="text-2xl font-bold">--</div>
                    <div class="text-[10px] font-bold uppercase">Days</div>
                </div>
                <div class="bg-white/95 rounded-lg p-2 text-center shadow-inner">
                    <div id="hours" class="text-2xl font-bold">--</div>
                    <div class="text-[10px] font-bold uppercase">Hours</div>
                </div>
                <div class="bg-white/95 rounded-lg p-2 text-center shadow-inner">
                    <div id="minutes" class="text-2xl font-bold">--</div>
                    <div class="text-[10px] font-bold uppercase">Mins</div>
                </div>
                <div class="bg-white/95 rounded-lg p-2 text-center shadow-inner">
                    <div id="seconds" class="text-2xl font-bold">--</div>
                    <div class="text-[10px] font-bold uppercase">Secs</div>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8 max-w-5xl space-y-12">
        <section class="text-center max-w-2xl mx-auto">
            <div class="inline-block p-2 bg-amber-100 rounded-full mb-4">🍻</div>
            <h2 class="text-2xl font-bold text-amber-900 mb-4">乾杯で始まる、新しい一年</h2>
            <p class="text-gray-700 leading-relaxed">
                2026年の幕開けを、本場ドイツのクラフトビールで祝いましょう！<br>
                日本橋の夜景と共に、賑やかなひとときを。
            </p>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Schedule Card -->
            <div class="bg-white rounded-2xl card-shadow p-6 border-t-4 border-amber-500">
                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                    <i class="fas fa-clock mr-2 text-amber-500"></i> 当日の流れ
                </h3>
                <div class="chart-container mb-4">
                    <canvas id="scheduleChart"></canvas>
                </div>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-500">19:15 〜</span>
                        <span class="font-bold">受付開始（現地集合）</span>
                    </div>
                    <div class="flex justify-between items-center p-2 bg-amber-50 rounded text-sm">
                        <span class="text-amber-700 font-bold">19:30 〜</span>
                        <span class="text-amber-900 font-bold">パーティー開始（乾杯！）</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-gray-500">〜 21:30</span>
                        <span class="font-bold">終了・解散</span>
                    </div>
                </div>
            </div>

            <!-- Map/Access Card -->
            <div class="bg-white rounded-2xl card-shadow overflow-hidden flex flex-col border-t-4 border-amber-800">
                <div class="p-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-map-marker-alt mr-2 text-amber-800"></i> 会場アクセス
                    </h3>
                    <!-- Google Maps Embed: 日本橋高島屋SC -->
                    <div class="w-full h-48 rounded-lg overflow-hidden bg-gray-100 mb-4">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.828030386114!2d139.77114677685458!3d35.68123743003056!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188be33075c3f1%3A0xc3f9408e063f1012!2z5pel5pys5qmL6auY5bO25bGLIFMuQy4!5e0!3m2!1sja!2sjp!4v1700000000000!5m2!1sja!2sjp" 
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
                        </iframe>
                    </div>
                    <p class="text-xs text-gray-500 leading-tight">
                        東京都中央区日本橋2-5-1 日本橋髙島屋S.C. 新館 7F<br>
                        「日本橋駅」直結 / 「東京駅」徒歩5分
                    </p>
                </div>
                <div class="mt-auto p-4 bg-gray-50 border-t border-gray-100">
                    <a href="https://tabelog.com/tokyo/A1302/A130202/13225175/" target="_blank" class="flex items-center justify-center w-full bg-amber-800 text-white text-sm font-bold py-3 rounded-lg hover:bg-black transition">
                        店舗詳細（食べログ） <i class="fas fa-external-link-alt ml-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <div class="text-xl mb-1">🚭</div>
                <div class="font-bold text-sm">全席禁煙</div>
                <div class="text-[10px] text-gray-400">店外正面に喫煙所あり</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <div class="text-xl mb-1">👔</div>
                <div class="font-bold text-sm">ドレスコード</div>
                <div class="text-[10px] text-gray-400">カジュアルでOKです</div>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <div class="text-xl mb-1">📢</div>
                <div class="font-bold text-sm">出欠締切</div>
                <div class="text-[10px] text-gray-400">12/26(金) まで</div>
            </div>
        </div>

        <section class="text-center py-10 bg-white rounded-3xl shadow-xl border border-amber-100">
            <h3 class="text-2xl font-bold text-gray-800 mb-6">ご参加をお待ちしております</h3>
            <button onclick="handleRSVP()" id="rsvp-btn" class="inline-flex items-center px-8 py-4 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-full text-lg shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-1">
                <i class="fas fa-check-circle mr-2"></i> 出欠を回答する
            </button>
            <div id="rsvp-msg" class="hidden mt-4 text-green-600 font-bold animate-pulse">
                回答ありがとうございます！
            </div>
        </section>
    </main>

    <footer class="bg-gray-900 text-gray-500 py-8 text-center text-xs">
        <p>&copy; 2026 新年会実行委員会</p>
    </footer>

    <script>
        // Countdown
        function updateTimer() {
            const target = new Date('2026-01-08T19:30:00').getTime();
            const now = new Date().getTime();
            const d = target - now;
            if (d < 0) {
                document.getElementById('countdown-container').innerHTML = '<div class="col-span-4 text-2xl font-bold">Party On!</div>';
                return;
            }
            document.getElementById('days').innerText = Math.floor(d / (1000 * 60 * 60 * 24));
            document.getElementById('hours').innerText = Math.floor((d % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById('minutes').innerText = Math.floor((d % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById('seconds').innerText = Math.floor((d % (1000 * 60)) / 1000);
        }
        setInterval(updateTimer, 1000);
        updateTimer();

        // Chart
        document.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('scheduleChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['受付', 'パーティー'],
                    datasets: [{
                        data: [15, 120],
                        backgroundColor: ['#FEF3C7', '#D97706'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    cutout: '70%'
                }
            });
        });

        // RSVP
        function handleRSVP() {
            const btn = document.getElementById('rsvp-btn');
            const msg = document.getElementById('rsvp-msg');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> 送信中...';
            setTimeout(() => {
                btn.style.display = 'none';
                msg.classList.remove('hidden');
            }, 1000);
        }

        // Bubbles
        const canvas = document.getElementById('bubbleCanvas');
        const bCtx = canvas.getContext('2d');
        let bubbles = [];
        function resize() {
            canvas.width = canvas.parentElement.offsetWidth;
            canvas.height = canvas.parentElement.offsetHeight;
        }
        window.addEventListener('resize', resize);
        resize();
        class Bubble {
            constructor() { this.reset(); this.y = Math.random() * canvas.height; }
            reset() { this.x = Math.random() * canvas.width; this.y = canvas.height + 20; this.s = 0.5 + Math.random(); this.r = 1 + Math.random() * 3; this.o = 0.1 + Math.random() * 0.4; }
            update() { this.y -= this.s; if (this.y < -10) this.reset(); }
            draw() { bCtx.beginPath(); bCtx.arc(this.x, this.y, this.r, 0, Math.PI * 2); bCtx.fillStyle = `rgba(255, 255, 255, ${this.o})`; bCtx.fill(); }
        }
        for(let i=0; i<40; i++) bubbles.push(new Bubble());
        function anim() { bCtx.clearRect(0,0,canvas.width,canvas.height); bubbles.forEach(b => { b.update(); b.draw(); }); requestAnimationFrame(anim); }
        anim();
    </script>
</body>
</html>